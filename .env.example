# neura configuration — copy to .env or export before starting the shim
NW_SHIM_PORT=8787
NW_PROXY_MODE=auto          # auto | single | off
# NW_PROXY=http://user:pass@ip:port   # only when NW_PROXY_MODE=single
NW_PROXY_MIN_POOL=3
NW_PROXY_MAX_POOL=20
NW_PROXY_TIMEOUT=6
NW_PROBE_TIMEOUT=5
NW_PROXY_REFRESH_SEC=600
NW_DIRECT_FALLBACK=1
NW_UA=opencode
# NW_DEBUG=1